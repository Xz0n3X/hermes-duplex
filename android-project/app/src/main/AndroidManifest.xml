<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A reply or an approval buzzes the phone; see Alerts. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Needed to put the audio stack in communication mode, which is what
         actually switches on the hardware echo canceller. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Without a microphone-typed foreground service, Android suspends
         recording as soon as the screen goes off and the session dies with
         no error at all. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A television is a real target for this app: voice in and voice out is
         the one interaction a remote control is bad at and a room microphone
         is good at. `touchscreen` is implicitly required by every app and a TV
         has none; `leanback` required=false keeps one APK installable on the
         phone and the tablet as well. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner_tv"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HermesDuplex">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- The Google TV home screen lists only this category. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/settings" android:parentActivityName=".MainActivity" />
        <activity android:name=".DebugActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/debug" android:parentActivityName=".MainActivity" />
        <activity android:name=".RemotesActivity" android:exported="false"
            android:label="@string/remotes" android:parentActivityName=".MainActivity" />
        <activity android:name=".UsageActivity" android:exported="false"
            android:label="@string/usage" android:parentActivityName=".MainActivity" />
        <activity android:name=".VoiceBrowserActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/more_voices" android:parentActivityName=".MainActivity" />
        <activity android:name=".TimingActivity" android:exported="false"
            android:label="@string/timing" android:parentActivityName=".MainActivity" />

        <!-- Woken by the system when the watch sends something, so a prompt
             from the wrist works with the phone app closed. -->
        <service
            android:name=".WearRelayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hermes" />
            </intent-filter>
        </service>

        <service
            android:name=".DuplexService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
